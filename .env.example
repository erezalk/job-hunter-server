# Copy to .env (gitignored) in this directory, or export the variables before
# running ./mvnw spring-boot:run. Real environment variables win over .env.
# Every value is optional: the app runs as a job tracker without any of them.

# --- Recommended -------------------------------------------------------------

# Secret used to encrypt AI provider API keys at rest (AES-256-GCM).
# Required only to save an Anthropic/Gemini key. Use a long random value,
# e.g. `openssl rand -base64 48`, and keep it stable: keys saved under a
# different secret can no longer be read and must be entered again.
APP_ENCRYPTION_SECRET=

# Optional bootstrap account, created on a start with no user in the database,
# and only when BOTH email and password are set (password: 8+ characters).
# Leave unset to create the first account through Sign up instead; setting only
# one of the two stops the app at startup. Ignored once any user exists.
# APP_INITIAL_USER_EMAIL=you@example.com
# APP_INITIAL_USER_PASSWORD=
# APP_INITIAL_USER_FULL_NAME=Job Hunter

# --- Optional overrides (defaults shown) -------------------------------------

# Database (matches docker-compose.yml; local development credentials only)
# DB_URL=jdbc:postgresql://localhost:5432/job_hunter
# DB_USERNAME=job_hunter
# DB_PASSWORD=job_hunter

# API bind address/port and allowed browser origin(s)
# SERVER_ADDRESS=127.0.0.1
# SERVER_PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Browser login session inactivity timeout
# SESSION_TIMEOUT=24h

# CV storage
# CV_STORAGE_DIR=./data/cv-storage
# CV_MAX_FILE_SIZE_BYTES=10485760

# AI provider calls
# AI_CONNECT_TIMEOUT_MS=5000
# AI_READ_TIMEOUT_MS=45000
# AI_MAX_RETRIES=1
# AI_RETRY_INITIAL_BACKOFF_MS=1000
# AI_RETRY_MAX_WAIT_MS=5000
